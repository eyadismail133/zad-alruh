# Zad Al-Ruh — local release signing (copy to android/key.properties, never commit it)
#
# Create a keystore once (keep it AND the passwords safe forever — losing it means
# users must uninstall to get updates):
#   keytool -genkey -v -keystore android/zad-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias zad
#
# On CI the same values come from GitHub secrets — see docs/ANDROID-SIGNING.ar.md.

storeFile=zad-release.jks
storePassword=
keyAlias=zad
keyPassword=
