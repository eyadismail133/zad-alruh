<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy Android Auto Backup Rules (< Android 12 / API 26-30) -->
<!-- Configures backup exclusions for all 9 standard and device-protected storage domains -->
<!-- Note: Cache and no-backup directories are automatically excluded by the Android system -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
